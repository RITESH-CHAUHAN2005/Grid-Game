# ===== Grid Dominion frontend — environment =====
# Copy this to .env.local (for local dev override) or set in your host's build env.
# Vite only exposes vars prefixed with VITE_ to the browser.

# Where the API lives. Leave unset to default to http://localhost:5000.
# Production: full URL of your Render backend, e.g.
#   VITE_API_URL=https://grid-dominion-api.onrender.com
VITE_API_URL=http://localhost:5000
