# ===== Grid Dominion API — environment =====
# Copy this file to .env (for local dev) and set real values.
# In production (Render), set these in the Render dashboard → Environment.

# Port the API listens on. Render auto-assigns one via PORT.
PORT=5000

# MongoDB connection string.
# Local:    mongodb://127.0.0.1:27017/grid_dominion
# Atlas:    mongodb+srv://<user>:<password>@<cluster>.mongodb.net/grid-dominion?retryWrites=true&w=majority
# On Atlas: whitelist 0.0.0.0/0 for Render (their outbound IPs rotate).
MONGODB_URI=mongodb://127.0.0.1:27017/grid_dominion

# Secret used to sign JWTs. Generate a fresh long random string for prod.
# Quick generator:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string

# JWT lifetime
JWT_EXPIRES_IN=7d

# Allowed origins for CORS, comma-separated.
# Local:       http://localhost:5173
# Production:  https://your-site.hostingersite.com,https://your-custom-domain.com
# DO NOT use "*" with credentials:true — list exact origins instead.
CORS_ORIGIN=http://localhost:5173
